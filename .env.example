# Copy to .env (never commit) for local reference.
# The Cloudflare worker reads secrets from KV (__agency), not from this file.
# This .env is for documentation + any CLI scripts you run locally.

# GoHighLevel — agency sub-account
GHL_LOCATION_ID=YOUR_GHL_LOCATION_ID
GHL_PIT_NARROW=pit-REPLACE_ME            # Contacts.read + Contacts.write
GHL_PIT_AGENCY=pit-REPLACE_ME            # Agency-level (less commonly used)
GHL_CUSTOM_FIELD_FOLDER=Onboarding       # GHL UI folder name

# Cloudflare
CF_ACCOUNT_EMAIL=you@example.com
CF_ACCOUNT_ID=YOUR_CF_ACCOUNT_ID
CF_WORKER_NAME=leads-proxy
CF_KV_NAMESPACE_ID=YOUR_KV_NAMESPACE_ID
CF_KV_BINDING=CLIENTS

# Public URLs
WORKER_URL=https://your-worker.workers.dev
FORM_URL=https://onboarding.youragency.com/YOUR-FUNNEL-PAGE-SLUG
